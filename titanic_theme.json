{
  "name": "Titanic Midnight Gold",
  "dataColors": ["#2EC4B6", "#FF6B6B", "#F5B841", "#5B8DEF", "#9B7EDE", "#8FA3BF", "#4ADE80", "#FB923C"],
  "background": "#0B1B33",
  "foreground": "#E8EEF7",
  "tableAccent": "#F5B841",
  "good": "#2EC4B6",
  "bad": "#FF6B6B",
  "neutral": "#F5B841",
  "maximum": "#2EC4B6",
  "center": "#F5B841",
  "minimum": "#FF6B6B",
  "textClasses": {
    "callout": { "fontSize": 34, "fontFace": "Segoe UI Semibold", "color": "#F5B841" },
    "title": { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#E8EEF7" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#E8EEF7" },
    "label": { "fontSize": 11, "fontFace": "Segoe UI", "color": "#B8C4D8" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "*": [{ "fontFamily": "Segoe UI", "color": { "solid": { "color": "#B8C4D8" } } }],
        "background": [{ "color": { "solid": { "color": "#13294B" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#1F3A63" } }, "radius": 10 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#E8EEF7" } }, "fontSize": 13 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0B1B33" } }, "transparency": 0 }]
      }
    }
  }
